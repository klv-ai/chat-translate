# Translation backend: deepl | local | ollama
TRANSLATION_PROVIDER=deepl

# --- DeepL (managed) ---
# Free keys end in ":fx" and automatically use the free host.
DEEPL_API_KEY=

# --- Local GGUF via llama-cpp-python (requires the [local] extra) ---
# Path to an instruction-tuned TranslateGemma .gguf, e.g. under ../model_files/
MODEL_PATH=

# --- TranslateGemma via Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=translategemma:4b
# OLLAMA_TIMEOUT_SECONDS=60
# OLLAMA_KEEP_ALIVE=5m
# OLLAMA_MAX_OUTPUT_TOKENS=

# --- General instruct model for catalog review / plural expansion ---
# Only needed for review_catalog / expand_message and the CLI's
# `review` and `plurals` commands.
# COMPLETION_PROVIDER=ollama
# COMPLETION_MODEL=
# Defaults to OLLAMA_HOST.
# COMPLETION_HOST=
# COMPLETION_TIMEOUT_SECONDS=120
# COMPLETION_KEEP_ALIVE=5m
