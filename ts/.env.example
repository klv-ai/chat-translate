# Which translation backend to use: deepl | translategemma
TRANSLATION_PROVIDER=deepl

# --- DeepL (managed) ---
# Free keys end in ":fx" and automatically use the free host.
DEEPL_API_KEY=

# --- TranslateGemma (self-hosted via Ollama) ---
# For docker compose --profile selfhosted, use http://ollama:11434
OLLAMA_HOST=http://localhost:11434
TRANSLATEGEMMA_MODEL=translategemma:4b

# --- Server ---
HOST=0.0.0.0
PORT=8080

# Detector fallback language + the subset it considers (ISO 639-1, comma-separated).
DEFAULT_UI_LANG=en
DETECTOR_SUBSET=en,de,fr,es,it,pt,nl

# Fastify log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
